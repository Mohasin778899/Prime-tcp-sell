    badge_sequence = [1048576, 32768, 2048, 64, 262144]
    badge_index = 0
    for i in range(3000):
        try:
            current_badge_value = badge_sequence[badge_index % 5]
            fields = {
                1: 78,
                2: {
                    1: int(Rm), 2: "iG:[C][B][FF0000] TOM TCP", 3: {2: 1, 3: 1},
