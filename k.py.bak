from cfonts import render

                                                                 
REGION_PREF = "BD"

def load_credentials(filename="\u0053\u0048\101\x50\u0050\u004e\x4f.txt"):
    """Load the game UID and password from the local credentials file."""
    values = {}
    try:
        with open(filename, "r", encoding="utf-8") as credential_file:
            for raw_line in credential_file:
                line = raw_line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                values[key.strip().upper()] = value.strip()
    except FileNotFoundError:
        raise RuntimeError("\123\x48\x41\u0050\120\x4e\117.txt not found. Create it with UID=... and PASSWORD=...")

    uid = values.get("UID", "")
    password = values.get("PASSWORD", "")
    if not uid or not password:
        raise RuntimeError("\u0053\u0048\101\u0050\120\x4e\x4f.txt must contain both UID=... and PASSWORD=...")
    return uid, password

BOT_UID, BOT_PASSWORD = load_credentials()
BOT_UID_FOR_HI, BOT_PW_FOR_HI = BOT_UID, BOT_PASSWORD


def log(level, message):
    icons = {
        "INFO":  ("\033[1;36m", "ℹ"),
        "OK":    ("\033[1;32m", "✔"),
        "WAIT":  ("\033[1;33m", "⏳"),
        "WARN":  ("\033[1;33m", "⚠"),
        "ERROR": ("\033[1;31m", "✘"),
        "BOT":   ("\033[1;35m", "★"),
    }
    color, icon = icons.get(level, ("\033[1;37m", "•"))
    reset = "\033[0m"
    ts = time.strftime("%H:%M:%S")
    print(f"\033[1;90m[{ts}]{reset} {color}{icon} {level:<5}{reset} │ {message}")


def print_banner():
    os.system("clear")
    print()
    print(render("\123\u0048\x41\x50\x50\u004e\117", colors=["blue", "white"], align="center"))
    print(render("TCP", colors=["yellow", "white"], align="center"))
    print()
    print(f"\033[1;35m{'═' * 60}\033[0m")
    print(f"\033[1;33m{'TCP BOT  •  PREMIUM'.center(60)}\033[0m")
    print(f"\033[1;35m{'═' * 60}\033[0m")
    print(f"\033[1;37m{'EVO  •  TEAM  •  MATCH  •  ONLINE'.center(60)}\033[0m")
    print(f"\033[1;35m{'═' * 60}\033[0m")
    print(f"\033[1;36m{'© \u0053\u0048\x41\x50\x50\116\u004f TCP PREMIUM'.center(60)}\033[0m")
    print(f"\033[1;35m{'═' * 60}\033[0m")
    print()


def print_box(title, lines, color="\033[1;35m"):
    width = 58
    reset = "\033[0m"
    print(f"\\n{color}┌{'─' * width}┐{reset}")
    print(f"{color}│{reset} {title.center(width - 1)}{color}│{reset}")
    print(f"{color}├{'─' * width}┤{reset}")
    for line in lines:
        print(f"{color}│{reset} {line:<{width - 1}}{color}│{reset}")
    print(f"{color}└{'─' * width}┘{reset}")


def print_line(title, value, icon="➤"):
    print(f"  {icon} \033[1;36m{title:<14}\033[0m : \033[1;33m{value}\033[0m")


async def MaiiiinE():
    global bot_uid, ToKen, region

    Uid = BOT_UID
    Pw = BOT_PASSWORD

    print_banner()
    log("INFO", "লগইন প্রক্রিয়া শুরু হচ্ছে ...")
    log("INFO", f"লক্ষ্য অঞ্চল: {REGION_PREF}")

    try:
        result = await login_engine.do_login(Uid, Pw, REGION_PREF)
    except Exception as e:
        log("ERROR", f"লগইন সমস্যা: {e}")
        return

    if not result:
        log("ERROR", "লগইন ব্যর্থ হয়েছে ")
        await asyncio.sleep(10)
        return

    bot_uid = result["bot_uid"]
    ToKen = result["token"]
    region = result["region"]

    key = result["key"]
    iv = result["iv"]
    timestamp = result["timestamp"]
    online_ip = result["online_ip"]
    online_port = result["online_port"]
    chat_ip = result["chat_ip"]
    chat_port = result["chat_port"]
    acc_name = result["account_name"]
    clan_id = result.get("clan_id")
    clan_data = result.get("clan_data")

    os.system("clear")
    RESET = "\033[0m"
    GREEN = "\033[1;32m"
    PURPLE = "\033[1;35m"

    print()
    print(render("\u0053\x48\101\u0050\u0050\u004e\x4f", colors=["blue", "white"], align="center"))
    print(render("TCP", colors=["yellow", "white"], align="center"))
    print()
    print(f"{PURPLE}{'═' * 60}{RESET}")
    print(f"\033[1;33m{'BOT ONLINE'.center(60)}\033[0m")
    print(f"{PURPLE}{'═' * 60}{RESET}")
    print()

    print_box("ACCOUNT INFORMATION", [
        f"UID          : {result['bot_uid']}",
        f"NAME         : {acc_name}",
        f"REGION       : {result['region']}",
        f"CLAN ID      : {clan_id or 'None'}",
        f"CHAT SERVER  : {chat_ip}:{chat_port}",
        f"GAME SERVER  : {online_ip}:{online_port}",
    ], GREEN)

    print_box("BOT STATUS", [
        "LOGIN SUCCESSFUL",
        "AUTHENTICATION READY",
        "TCP CONNECTION INITIALIZING",
    ], PURPLE)

    log("INFO", "অথ টোকেন তৈরি করা হচ্ছে ...")
    ChatAutH = create_auth_token_chat(
        int(result["bot_uid"]), result["token"], int(timestamp), key, iv
    )
    OnlineAutH, _ = build_ob55_online_auth(
        int(result["bot_uid"]), result["token"], int(timestamp), key, iv
    )

    log("OK", "অথ টোকেন প্রস্তুত ")
    log("WAIT", "চ্যাট সার্ভারে সংযুক্ত হচ্ছে ...")

    ready_event = asyncio.Event()
    t1 = asyncio.create_task(TcPChaT(
        chat_ip, chat_port, ChatAutH, key, iv, ready_event, result["region"],
        clan_id=clan_id, clan_data=clan_data,
    ))

    await ready_event.wait()
    log("OK", "চ্যাট সার্ভার সংযোগ সফল ")
    await asyncio.sleep(1)

    log("WAIT", "অনলাইন সার্ভারে সংযুক্ত হচ্ছে ...")
    t2 = asyncio.create_task(
        TcPOnLine(online_ip, online_port, key, iv, OnlineAutH)
    )

    print()
    print(f"{PURPLE}{'═' * 60}{RESET}")
    print(render("\123\110\101\u0050\x50\u004e\u004f", colors=["blue", "white"], align="center"))
    print(render("TCP", colors=["yellow", "white"], align="center"))
    print(f"{PURPLE}{'═' * 60}{RESET}")
    print_line("Owner", "\123\x48\101\120\x50\116\u004f")
    print_line("Region", result["region"])
    print_line("Bot UID", result["bot_uid"])
    print_line("Name", acc_name)
    print_line("Clan", str(clan_id) if clan_id else "None")
    print_line("Status", "\033[1;32m● RUNNING\033[0m")
    print(f"{PURPLE}{'═' * 60}{RESET}")
    print()

    await asyncio.gather(t1, t2)


async def StarTinG():
    attempt = 0
    while True:
        attempt += 1
        try:
            log("BOT", f"সেশন #{attempt} শুরু হচ্ছে")
            await asyncio.wait_for(MaiiiinE(), timeout=7 * 60 * 60)
        except asyncio.TimeoutError:
            log("WARN", "সেশন শেষ  আবার চালু হচ্ছে ...")
            await asyncio.sleep(3)
        except KeyboardInterrupt:
            log("WARN", "বট বন্ধ করা হয়েছে ")
            sys.exit(0)
        except Exception as e:
            log("ERROR", f"সমস্যা: {e}")
            await asyncio.sleep(5)



_XC4_SOURCE = '\n\nimport requests\nimport json\nimport binascii\nimport time\nimport urllib3\nimport base64\nimport datetime\nimport re\nimport socket\nimport threading\nimport random\nimport os\nimport asyncio\n\nfrom protobuf_decoder.protobuf_decoder import Parser\nfrom Crypto.Cipher import AES\nfrom Crypto.Util.Padding import pad, unpad\nfrom datetime import datetime\nfrom google.protobuf.timestamp_pb2 import Timestamp\n\nurllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)\n\n\n                                                                 \n                                                             \n                                                                 \n\nbot_uid = None\nToKen   = None\nregion  = None\n\n\n                                                                 \n                                              \n                                                                 \n\nKey = bytes([89, 103, 38, 116, 99, 37, 68, 69, 117, 104, 54, 37, 90, 99, 94, 56])\nIv  = bytes([54, 111, 121, 90, 68, 114, 50, 50, 69, 51, 121, 99, 104, 106, 77, 37])\n\n\n                                                                 \n                                            \n                                                                 \n\nasync def EnC_AEs(HeX):\n    """API পেলোড এনক্রিপ্ট (hex → hex)"""\n    cipher = AES.new(Key, AES.MODE_CBC, Iv)\n    return cipher.encrypt(pad(bytes.fromhex(HeX), AES.block_size)).hex()\n\n\nasync def DEc_AEs(HeX):\n    """API পেলোড ডিক্রিপ্ট (hex → hex)"""\n    cipher = AES.new(Key, AES.MODE_CBC, Iv)\n    return unpad(cipher.decrypt(bytes.fromhex(HeX)), AES.block_size).hex()\n\n\nasync def EnC_PacKeT(HeX, K, V):\n    """TCP প্যাকেট এনক্রিপ্ট"""\n    return AES.new(K, AES.MODE_CBC, V).encrypt(pad(bytes.fromhex(HeX), 16)).hex()\n\n\nasync def DEc_PacKeT(HeX, K, V):\n    """TCP প্যাকেট ডিক্রিপ্ট"""\n    return unpad(AES.new(K, AES.MODE_CBC, V).decrypt(bytes.fromhex(HeX)), 16).hex()\n\n\n                                                                 \n                                           \n                                                                 \n\nasync def EnC_Uid(H, Tp):\n    """UID কে varint এ রূপান্তর"""\n    e, H = [], int(H)\n    while H:\n        e.append((H & 0x7F) | (0x80 if H > 0x7F else 0))\n        H >>= 7\n    return bytes(e).hex() if Tp == \'Uid\' else None\n\n\nasync def EnC_Vr(N):\n    """যেকোনো সংখ্যাকে varint বাইটে রূপান্তর"""\n    if N < 0:\n        return b\'\'\n    H = []\n    while True:\n        BesTo = N & 0x7F\n        N >>= 7\n        if N:\n            BesTo |= 0x80\n        H.append(BesTo)\n        if not N:\n            break\n    return bytes(H)\n\n\ndef DEc_Uid(H):\n    """varint hex থেকে আসল সংখ্যায় রূপান্তর"""\n    n = s = 0\n    for b in bytes.fromhex(H):\n        n |= (b & 0x7F) << s\n        if not b & 0x80:\n            break\n        s += 7\n    return n\n\n\n                                                                 \n                                                  \n                                                                 \n\nasync def CrEaTe_VarianT(field_number, value):\n    """Varint ফিল্ড তৈরি"""\n    field_header = (field_number << 3) | 0\n    return await EnC_Vr(field_header) + await EnC_Vr(value)\n\n\nasync def CrEaTe_LenGTh(field_number, value):\n    """Length-delimited ফিল্ড তৈরি"""\n    field_header = (field_number << 3) | 2\n    encoded_value = value.encode() if isinstance(value, str) else value\n    return await EnC_Vr(field_header) + await EnC_Vr(len(encoded_value)) + encoded_value\n\n\nasync def CrEaTe_ProTo(fields):\n    """ডিকশনারি থেকে সম্পূর্ণ protobuf বডি তৈরি"""\n    packet = bytearray()\n    for field, value in fields.items():\n        if isinstance(value, dict):\n            nested_packet = await CrEaTe_ProTo(value)\n            packet.extend(await CrEaTe_LenGTh(field, nested_packet))\n        elif isinstance(value, int):\n            packet.extend(await CrEaTe_VarianT(field, value))\n        elif isinstance(value, str) or isinstance(value, bytes):\n            packet.extend(await CrEaTe_LenGTh(field, value))\n    return packet\n\n\n                                                                 \n                                          \n                                                                 \n\nasync def DecodE_HeX(H):\n    """সংখ্যাকে 2-ডিজিট হেক্সে রূপান্তর"""\n    R = hex(H)\n    F = str(R)[2:]\n    if len(F) == 1:\n        F = "0" + F\n        return F\n    else:\n        return F\n\n\nasync def Fix_PackEt(parsed_results):\n    """protobuf পার্স রেজাল্ট ফিক্স"""\n    result_dict = {}\n    for result in parsed_results:\n        field_data = {}\n        field_data[\'wire_type\'] = result.wire_type\n        if result.wire_type == "varint":\n            field_data[\'data\'] = result.data\n        if result.wire_type == "string":\n            field_data[\'data\'] = result.data\n        if result.wire_type == "bytes":\n            field_data[\'data\'] = result.data\n        elif result.wire_type == \'length_delimited\':\n            field_data["data"] = await Fix_PackEt(result.data.results)\n        result_dict[result.field] = field_data\n    return result_dict\n\n\nasync def DeCode_PackEt(input_text):\n    """হেক্স প্যাকেট পার্স করে JSON রিটার্ন"""\n    try:\n        parsed_results = Parser().parse(input_text)\n        parsed_results_dict = await Fix_PackEt(parsed_results)\n        json_data = json.dumps(parsed_results_dict)\n        return json_data\n    except Exception as e:\n        print(f"error {e}")\n        return None\n\n\n                                                                 \n                                               \n                                                                 \n\ndef xMsGFixinG(n):\n    """৩ ডিজিট গ্রুপ করে মেসেজ স্প্লিট"""\n    return \'🗿\'.join(str(n)[i:i + 3] for i in range(0, len(str(n)), 3))\n\n\nasync def Ua():\n    """র্যান্ডম User-Agent জেনারেটর"""\n    versions = [\n        \'4.0.18P6\', \'4.0.19P7\', \'4.0.20P1\', \'4.1.0P3\', \'4.1.5P2\', \'4.2.1P8\',\n        \'4.2.3P1\', \'5.0.1B2\', \'5.0.2P4\', \'5.1.0P1\', \'5.2.0B1\', \'5.2.5P3\',\n        \'5.3.0B1\', \'5.3.2P2\', \'5.4.0P1\', \'5.4.3B2\', \'5.5.0P1\', \'5.5.2P3\'\n    ]\n    models = [\n        \'SM-A125F\', \'SM-A225F\', \'SM-A325M\', \'SM-A515F\', \'SM-A725F\', \'SM-M215F\', \'SM-M325FV\',\n        \'Redmi 9A\', \'Redmi 9C\', \'POCO M3\', \'POCO M4 Pro\', \'RMX2185\', \'RMX3085\',\n        \'moto g(9) play\', \'CPH2239\', \'V2027\', \'OnePlus Nord\', \'ASUS_Z01QD\',\n    ]\n    android_versions = [\'9\', \'10\', \'11\', \'12\', \'13\', \'14\']\n    languages = [\'en-US\', \'es-MX\', \'pt-BR\', \'id-ID\', \'ru-RU\', \'hi-IN\']\n    countries = [\'USA\', \'MEX\', \'BRA\', \'IDN\', \'RUS\', \'VN\']\n    version = random.choice(versions)\n    model = random.choice(models)\n    android = random.choice(android_versions)\n    lang = random.choice(languages)\n    country = random.choice(countries)\n    return f"GarenaMSDK/{version}({model};Android {android};{lang};{country};)"\n\n\nasync def ArA_CoLor():\n    """র্যান্ডম হেক্স কালার (নামের সামনে বসে)"""\n    Tp = [\n        "32CD32", "00BFFF", "00FA9A", "90EE90", "FF4500", "FF6347", "FF69B4",\n        "FF8C00", "FF6347", "FFD700", "FFDAB9", "F0F0F0", "F0E68C", "D3D3D3",\n        "A9A9A9", "D2691E", "CD853F", "BC8F8F", "6A5ACD", "483D8B", "4682B4",\n        "9370DB", "C71585", "FF8C00", "FFA07A"\n    ]\n    return random.choice(Tp)\n\n\nasync def xBunnEr():\n    """র্যান্ডম ব্যানার আইডি"""\n    bN = [\n        902000126, 902000154, 902000003, 902027018, 902027027, 902039014,\n        902040027, 902042011, 902048021, 902048018, 902000027, 902000078,\n        902000013, 902000093, 902000100, 902000117, 902000111, 902000151,\n        902000207, 902000203, 902027016, 902027018, 902033016, 902027018,\n        902027018, 902027018, 902027018, 902027018, 902027018, 902055006, \n        902055003\n    ]\n    return random.choice(bN)\n\n\n                                                                 \n                                                  \n                                                                 \n\nasync def xSEndMsg_new(Msg, Tp, Tp2, id, K, V):\n    """চ্যাট / স্কোয়াড মেসেজ প্যাকেট"""\n    feilds = {\n        1: id, 2: Tp2, 3: Tp, 4: Msg, 5: 1735129800, 7: 2,\n        9: {\n            1: "xBesTo - C4", 2: int(await xBunnEr()), 3: 901048018, 4: 330,\n            5: 909034009, 8: "xBesTo - C4", 10: 1, 11: 1, 13: {1: 2},\n            14: {\n                1: 12484827014, 2: 8,\n                3: "\\u0010\\u0015\\b\\n\\u000b\\u0013\\f\\u000f\\u0011\\u0004\\u0007\\u0002\\u0003\\r\\u000e\\u0012\\u0001\\u0005\\u0006"\n            },\n            12: 0\n        },\n        10: "en", 13: {3: 1}\n    }\n    Pk = (await CrEaTe_ProTo(feilds)).hex()\n    Pk = "080112" + await EnC_Uid(len(Pk) // 2, Tp=\'Uid\') + Pk\n    return await GeneRaTePk(Pk, \'1201\', K, V)\n\n\nasync def xSEndMsgsQ_new(Msg, id, K, V):\n    """স্কোয়াড চ্যাট মেসেজ"""\n    fields = {\n        1: id, 2: id, 4: Msg, 5: 1756580149, 7: 2, 8: 904990072,\n        9: {\n            1: "xBe4!sTo - C4", 2: await xBunnEr(), 4: 330, 5: 827001005,\n            8: "xBe4!sTo - C4", 10: 1, 11: 1, 13: {1: 2},\n            14: {\n                1: 1158053040, 2: 8,\n                3: "\\u0010\\u0015\\b\\n\\u000b\\u0015\\f\\u000f\\u0011\\u0004\\u0007\\u0002\\u0003\\r\\u000e\\u0012\\u0001\\u0005\\u0006"\n            }\n        },\n        10: "en", 13: {2: 2, 3: 1}\n    }\n    Pk = (await CrEaTe_ProTo(fields)).hex()\n    Pk = "080112" + await EnC_Uid(len(Pk) // 2, Tp=\'Uid\') + Pk\n    return await GeneRaTePk(Pk, \'1201\', K, V)\n\n\n                                                                 \n                                     \n                                                                 \n\nasync def AuthClan(CLan_Uid, AuTh, K, V):\n    """ক্ল্যান অথেনটিকেশন"""\n    fields = {1: 3, 2: {1: int(CLan_Uid), 2: 1, 4: str(AuTh)}}\n    return await GeneRaTePk((await CrEaTe_ProTo(fields)).hex(), \'1201\', K, V)\n\n\nasync def AutH_GlobAl(K, V):\n    """গ্লোবাল চ্যাট অথেনটিকেশন"""\n    fields = {1: 3, 2: {2: 5, 3: "en"}}\n    return await GeneRaTePk((await CrEaTe_ProTo(fields)).hex(), \'1215\', K, V)\n\n\nasync def AutH_Chat(T, uid, code, K, V):\n    """চ্যাট অথেনটিকেশন"""\n    fields = {1: T, 2: {1: uid, 3: "en", 4: str(code)}}\n    return await GeneRaTePk((await CrEaTe_ProTo(fields)).hex(), \'1215\', K, V)\n\n\n                                                                 \n                                         \n                                                                 \n\nasync def LagSquad(K, V):\n    """স্কোয়াড ল্যাগ চেক"""\n    fields = {1: 15, 2: {1: 1124759936, 2: 1}}\n    return await GeneRaTePk((await CrEaTe_ProTo(fields)).hex(), \'0515\', K, V)\n\n\nasync def GeT_Status(PLayer_Uid, K, V):\n    """প্লেয়ার স্ট্যাটাস চেক"""\n    PLayer_Uid = await EnC_Uid(PLayer_Uid, Tp=\'Uid\')\n    if len(PLayer_Uid) == 8:\n        Pk = f\'080112080a04{PLayer_Uid}1005\'\n    elif len(PLayer_Uid) == 10:\n        Pk = f"080112090a05{PLayer_Uid}1005"\n    return await GeneRaTePk(Pk, \'0f15\', K, V)\n\n\nasync def SPam_Room(Uid, Rm, Nm, K, V):\n    """রুম স্প্যাম প্যাকেট"""\n    fields = {\n        1: 78,\n        2: {\n            1: int(Rm), 2: f"[{ArA_CoLor()}]{Nm}", 3: {2: 1, 3: 1},\n            4: 330, 5: 1, 6: 201, 10: xBunnEr(), 11: int(Uid), 12: 1\n        }\n    }\n    return await GeneRaTePk((await CrEaTe_ProTo(fields)).hex(), \'0e15\', K, V)\n\n\nasync def GenJoinSquadsPacket_new(code, K, V):\n    """স্কোয়াড জয়েন (কোড দিয়ে)"""\n    fields = {}\n    fields[1] = 4\n    fields[2] = {}\n    fields[2][4] = bytes.fromhex("01090a0b121920")\n    fields[2][5] = str(code)\n    fields[2][6] = 6\n    fields[2][8] = 1\n    fields[2][9] = {}\n    fields[2][9][2] = 800\n    fields[2][9][6] = 11\n    fields[2][9][8] = "1.111.1"\n    fields[2][9][9] = 5\n    fields[2][9][10] = 1\n    return await GeneRaTePk((await CrEaTe_ProTo(fields)).hex(), \'0515\', K, V)\n\n\nasync def GenJoinGlobaL(owner, code, K, V):\n    """গ্লোবাল স্কোয়াড জয়েন"""\n    fields = {\n        1: 4,\n        2: {1: owner, 6: 1, 8: 1, 13: "en", 15: code, 16: "OR"}\n    }\n    return await GeneRaTePk((await CrEaTe_ProTo(fields)).hex(), \'0515\', K, V)\n\n\nasync def FS(K, V, region):\n    """ফ্রেন্ড স্ট্যাটাস / ফায়ার স্ট্যাটাস"""\n    fields = {1: 9, 2: {1: 13256361202}}\n    if region.lower() == "ind":\n        packet = \'0514\'\n    elif region.lower() == "bd":\n        packet = "0519"\n    else:\n        packet = "0515"\n    return await GeneRaTePk((await CrEaTe_ProTo(fields)).hex(), packet, K, V)\n\n\nasync def Emote_k(TarGeT, idT, K, V, region):\n    """ইমোট প্যাকেট"""\n    fields = {1: 21, 2: {1: 804266360, 2: 909000001, 5: {1: TarGeT, 3: idT}}}\n    if region.lower() == "ind":\n        packet = \'0514\'\n    elif region.lower() == "bd":\n        packet = "0519"\n    else:\n        packet = "0515"\n    return await GeneRaTePk((await CrEaTe_ProTo(fields)).hex(), packet, K, V)\n\n\nasync def GeTSQDaTa(D):\n    """স্কোয়াড ডেটা এক্সট্র্যাক্ট"""\n    uid = D[\'5\'][\'data\'][\'1\'][\'data\']\n    chat_code = D["5"]["data"]["17"]["data"]\n    squad_code = D["5"]["data"]["31"]["data"]\n    return uid, chat_code, squad_code\n\n\nasync def Msg_Sq(msg, owner, bot, K, V):\n    """স্কোয়াড মেসেজ"""\n    fields = {\n        1: 1,\n        2: 2,\n        2: {\n            1: bot, 2: owner, 4: msg, 5: 1757799182, 7: 2,\n            9: {\n                1: "\u0053\110\101\120\x50\u004e\x4f", 2: await xBunnEr(), 3: 909000024, 4: 330,\n                5: 909000024, 7: 2, 10: 1, 11: 1, 12: 0, 13: {1: 2},\n                14: {\n                    1: bot, 2: 8,\n                    3: "\\u0010\\u0015\\b\\n\\u000b\\u0013\\f\\u000f\\u0011\\u0004\\u0007\\u0002\\u0003\\r\\u000e\\u0012\\u0001\\u0005\\u0006"\n                }\n            },\n            10: "ar", 13: {3: 1}, 14: ""\n        }\n    }\n    proto_bytes = await CrEaTe_ProTo(fields)\n    return await GeneRaTePk(proto_bytes.hex(), \'1215\', K, V)\n\n\nasync def ghost_packet(player_id, secret_code, K, V):\n    """ঘোস্ট প্যাকেট (প্লেয়ার আইডি + সিক্রেট কোড)"""\n    fields = {\n        1: 61,\n        2: {\n            1: int(player_id),\n            2: {\n                1: int(player_id), 2: int(time.time()), 3: "\x53\u0048\u0041\u0050\x50\u004e\u004f",\n                5: 12, 6: 9999999, 7: 1,\n                8: {2: 1, 3: 1}, 9: 3,\n            },\n            3: secret_code,\n        },\n    }\n    return await GeneRaTePk((await CrEaTe_ProTo(fields)).hex(), \'0515\', K, V)\n\n\n                                                                 \n                                                   \n                                                                 \n\nasync def GeneRaTePk(Pk, N, K, V):\n    """প্যাকেট এনক্রিপ্ট + হেডার বসিয়ে ফাইনাল বাইট রিটার্ন"""\n    PkEnc = await EnC_PacKeT(Pk, K, V)\n    _ = await DecodE_HeX(int(len(PkEnc) // 2))\n    if len(_) == 2:\n        HeadEr = N + "000000"\n    elif len(_) == 3:\n        HeadEr = N + "00000"\n    elif len(_) == 4:\n        HeadEr = N + "0000"\n    elif len(_) == 5:\n        HeadEr = N + "000"\n    else:\n        print(\'ErroR => GeneRatinG ThE PacKeT !!\')\n        return None\n    return bytes.fromhex(HeadEr + _ + PkEnc)\n\n\n                                                                 \n                                         \n                                                                 \n\nasync def CreateNewSquad(K, V, region):\n    """নতুন স্কোয়াড তৈরি"""\n    fields = {\n        1: 1,\n        2: {\n            2: \'011d\', 3: 1, 4: 3, 5: \'ar\',\n            8: {1: \'IDC4\', 2: 145, 3: \'ME\'},\n            9: 1,\n            10: \'01030407090a0b12191a201d2729\',\n            11: 1, 13: 1,\n            14: {\n                1: {6: 56},\n                2: 731,\n                3: \'\',\n      