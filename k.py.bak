            spam_packet = await GeneRaTePk((await CrEaTe_ProTo(fields)).hex(), '0e15', K, V)
            await SEndPacKeT(whisper_writer, online_writer, 'OnLine', spam_packet)
            badge_index += 1
            await asyncio.sleep(PACKET_DELAY_ULTRA_FAST)
