                            uid, chat_id, key, iv
                        )
                    else:
                        expr = parts[1].strip().replace("×", "*").replace("÷", "/").replace("x", "*")
                        try:
                            import re as _re
                            if not _re.match(r'^[\d\s\+\-\*\/\.\(\)\%]+$', expr):
                                raise ValueError("Invalid")
                            result = eval(expr)
                            if isinstance(result, float) and result == int(result):
                                result = int(result)
                            P = await SEndMsG(
                                XX,
                                f"[B][C][FFFFFF]🧮  \n\n : {expr}\n : {result}",
                                uid, chat_id, key, iv
                            )
